// MCS-51 ELF relocation types. R_8051_16 is a little-endian data relocation;
// R_8051_16_BE is for high-byte-first code addresses in 8051 instructions.
// These values define LLVM's initial relocation ABI for EM_8051.
ELF_RELOC(R_8051_NONE, 0)
ELF_RELOC(R_8051_8, 1)
ELF_RELOC(R_8051_16, 2)
ELF_RELOC(R_8051_PCREL8, 3)
ELF_RELOC(R_8051_11, 4)
ELF_RELOC(R_8051_16_BE, 5)
ELF_RELOC(R_8051_DPTR16, 6)
// Low and high byte of an absolute address, for 8-bit immediate fields.
ELF_RELOC(R_8051_LO8, 7)
ELF_RELOC(R_8051_HI8, 8)
// Marks the preceding R_8051_DPTR16 at the same offset as a linker-relaxable
// MOV DPTR,#imm16. The assembler emits it only when every reference that may
// span the instruction is left as a symbol-relative relocation.
ELF_RELOC(R_8051_RELAX, 9)
// Address-space-tagged forms used for absolute MOVX and MOVC accesses.
ELF_RELOC(R_8051_DPTR16_XDATA, 10)
ELF_RELOC(R_8051_DPTR16_CODE, 11)
ELF_RELOC(R_8051_LO8_XDATA, 12)
ELF_RELOC(R_8051_HI8_XDATA, 13)
ELF_RELOC(R_8051_LO8_CODE, 14)
ELF_RELOC(R_8051_HI8_CODE, 15)
